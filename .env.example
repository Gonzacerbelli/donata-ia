# ─────────────────────────────────────────────────────────────────────────────
# Donata IA · variables de entorno
#
# Copiá este archivo como `.env` y completá los valores.
# NUNCA commitees el `.env` real: está en .gitignore.
# Generar un secreto JWT:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Aplicación ───────────────────────────────────────────────────────────────
APP_NAME=donata-ia-api
ENV=dev
LOG_LEVEL=INFO

# ── Base de datos (MongoDB) ──────────────────────────────────────────────────
# Por defecto apunta al contenedor `mongo` de docker-compose.
# Para usar Atlas: Dashboard de Atlas → Connect → Copy connection string
# (reemplazá usuario y contraseña, y agregá la IP a la whitelist).
MONGO_URI=mongodb://mongo:27017
MONGO_DB=donata_ia
# Base separada para los tests: evita tocar datos reales.
MONGO_DB_TEST=donata_ia_test

# ── Autenticación (CU01) ─────────────────────────────────────────────────────
# Secreto de firma del JWT. Generar uno nuevo para cada entorno. Sin valor por defecto.
JWT_SECRET=cambiar-esto-por-un-secreto-aleatorio-largo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# OAuth 2.0 con Google: console.cloud.google.com → APIs y servicios → Credenciales.
# El redirect URI debe coincidir EXACTAMENTE con el configurado en Google.
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# En desarrollo, permitir login local con usuario y contraseña.
# Debe quedar en false en producción: es una vía de acceso sin Google.
ENABLE_LOCAL_LOGIN=true
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=cambiar-esta-clave

# ── CORS ─────────────────────────────────────────────────────────────────────
# Lista blanca de orígenes permitidos. JSON array o CSV.
# Nunca usar "*" junto con credenciales.
CORS_ORIGINS=["http://localhost:5173"]

# ── Rate limiting (requests por minuto) ──────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10
RATE_LIMIT_CHAT=20
RATE_LIMIT_EXPORT=10
RATE_LIMIT_WRITE=60
RATE_LIMIT_GLOBAL=120

# ── Asistente IA (CU07) · 100% local, sin API cloud ─────────────────────────
# Backend en Docker:  http://host.docker.internal:11434
# Backend local:      http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.95
OLLAMA_MAX_TOKENS=2048
# Segundos antes de cortar la generación. Un 7B en CPU es lento.
OLLAMA_TIMEOUT=60

# ── Base vectorial (CU07) ────────────────────────────────────────────────────
# ChromaDB persistente. Dentro del contenedor api la ruta es relativa a /app.
CHROMA_DIR=data/chroma
# Embeddings locales (inferencia en CPU; la primera vez descarga los pesos).
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# Chunks a recuperar en el retriever (RAG de documentación).
RAG_TOP_K=4

# ── Chat IA (historial y herramientas) ───────────────────────────────────────
# Mensajes recientes por hilo que se reenvían al modelo.
CHAT_HISTORY_LIMIT=20
# Las tools del agente se exponen vía el servidor MCP propio (donata-mcp).
LLM_USE_MCP=true
# Guardrails: rechaza consultas fuera del negocio e inyecciones de prompt.
GUARDRAILS_ENABLED=true

# ── Frontend (build) ─────────────────────────────────────────────────────────
# Se inyecta en el build de Vite. Debe ser la URL pública del backend.
VITE_API_URL=http://localhost:8000
